		{
			"name": "Record Laboratory Observation",
			"event": [
				{
					"listen": "test",
					"script": {
						"id": "b1765190-df42-4f4c-9800-f53dab2b4c86",
						"exec": [
							"// Check that the engine completed the processing run safely\r",
							"pm.test(\"Validation Service Responded\", () => pm.response.to.have.status(200));\r",
							"\r",
							"pm.test(\"Catch Terminology and Schema Errors\", () => {\r",
							"    let res = pm.response.json();\r",
							"    \r",
							"    // 1. Confirm the server responded with the correct FHIR specification envelope\r",
							"    pm.expect(res.resourceType).to.equal(\"OperationOutcome\");\r",
							"    \r",
							"    // 2. Filter for specific errors regarding terminology or code system bindings\r",
							"    let structuralErrors = res.issue.filter(issue => {\r",
							"        let isHighSeverity = (issue.severity === 'error' || issue.severity === 'fatal');\r",
							"        \r",
							"        // Check if the diagnostics text mentions code, terminology, loinc, or binding issues\r",
							"        let diagnosticsText = (issue.diagnostics || \"\").toLowerCase();\r",
							"        let isTerminologyError = diagnosticsText.includes(\"code\") || \r",
							"                                  diagnosticsText.includes(\"loinc\") || \r",
							"                                  diagnosticsText.includes(\"terminology\");\r",
							"                                  \r",
							"        return isHighSeverity && isTerminologyError;\r",
							"    });\r",
							"    \r",
							"    // 3. Assert that the validation engine caught the bad LOINC code string\r",
							"    pm.expect(structuralErrors.length, \"Expected server to throw a terminology error for the invalid LOINC code, but none were caught.\").to.be.above(0);\r",
							"    \r",
							"    // 4. Output the exact error message to the console for easier bug triage\r",
							"    console.log(\"Expected Terminology Error Details:\", JSON.stringify(structuralErrors, null, 2));\r",
							"});\r",
							""
						],
						"type": "text/javascript",
						"packages": {},
						"requests": {}
					}
				}
			],
